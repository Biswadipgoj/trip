# Copy to mobile/.env (local runs) and set the same values as EAS environment
# variables for cloud builds — see mobile/README.md. These are inlined into
# the app bundle at build time. Use the SAME project as the web app (Vercel's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY) so web and phone
# share trips.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Deployed web app origin, used for invite links that open on any device.
EXPO_PUBLIC_WEB_URL=https://your-app.vercel.app
