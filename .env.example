# TripMate — Environment Variables
# Copy this file to .env.local and configure for your environment.

# ── Supabase (Database & Storage) ─────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (used ONLY locally for release APK uploads; NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL (Used for QR codes & invite redirects) ───────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Android Release Distribution (Optional) ──────────────────────────────────
# Direct fallback URL if serving APK from external CDN (e.g. EAS build artifact)
# NEXT_PUBLIC_TRIPMATE_ANDROID_APK_URL=https://expo.dev/artifacts/eas/...
