# TripMate — Environment Variables
# Copy this file to .env.local and configure for your environment.

# ── Supabase (Database & Storage) ─────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ─────────
# Supabase secret key (sb_secret_…): used only by /api/* routes and APK uploads.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
# Signs the login session cookies. At least 32 random characters:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# ── Site URL (Used for QR codes & invite redirects) ───────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Android Release Distribution (Optional) ──────────────────────────────────
# Direct fallback URL if serving APK from external CDN (e.g. EAS build artifact)
# NEXT_PUBLIC_TRIPMATE_ANDROID_APK_URL=https://expo.dev/artifacts/eas/...
